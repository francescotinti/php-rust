+// ---------------------------------------------------------------------------
+// S-151 tranche-5 (PROBE census, wp151-harness/s151-criterio-census.md §2):
+// handle STRUMENTATO dell'oggetto. `ObjRc` avvolge l'`Rc<RefCell<Object>>` di
+// `Zval::Object`, così ogni clone/drop/mint/borrow dell'handle passa da un
+// funnel chiuso dal COMPILATORE: un sito che vuole costruire il payload con un
+// `Rc` nudo NON compila — deve dichiararsi `ObjRc::birth` (nascita, C3/ledger)
+// o `.into()` (mint = addref da un Rc nudo, categoria `cloni` del ledger).
+// Fuori dalla feature `mem-census` i hook spariscono (wrapper trasparente,
+// stessa nicchia/il medesimo layout di un `Rc`). REGOLA del ledger: non esiste
+// alcun estrattore che RESTITUISCA un `Rc` nudo posseduto (solo `raw()` in
+// prestito): un handle tracciato non può uscire dal censimento senza drop.
+
+pub struct ObjRc(Rc<std::cell::RefCell<Object>>);
+
+impl ObjRc {
+    /// Nascita di un OGGETTO NUOVO (l'handle #1). Da usare SOLO nei funnel di
+    /// costruzione della VM (accanto a `created.insert`): registra la nascita
+    /// per classe nel ledger S-151.
+    #[inline]
+    pub fn birth(rc: Rc<std::cell::RefCell<Object>>) -> ObjRc {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_birth(&rc);
+        ObjRc(rc)
+    }
+
+    /// Prestito del `Rc` nudo SENZA contare (macchineria del censimento:
+    /// snapshot walker, strong_count, downgrade). MAI clonare il risultato in
+    /// un possessore che sopravvive: il ledger conta solo handle `ObjRc`.
+    #[inline]
+    pub fn raw(&self) -> &Rc<std::cell::RefCell<Object>> {
+        &self.0
+    }
+
+    #[inline]
+    pub fn borrow(&self) -> std::cell::Ref<'_, Object> {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_borrow(false);
+        self.0.borrow()
+    }
+
+    #[inline]
+    pub fn borrow_mut(&self) -> std::cell::RefMut<'_, Object> {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_borrow(true);
+        self.0.borrow_mut()
+    }
+
+    #[inline]
+    pub fn try_borrow(&self) -> Result<std::cell::Ref<'_, Object>, std::cell::BorrowError> {
+        let r = self.0.try_borrow();
+        #[cfg(feature = "mem-census")]
+        if r.is_ok() {
+            crate::memcensus::s151_borrow(false);
+        }
+        r
+    }
+
+    #[inline]
+    pub fn try_borrow_mut(
+        &self,
+    ) -> Result<std::cell::RefMut<'_, Object>, std::cell::BorrowMutError> {
+        let r = self.0.try_borrow_mut();
+        #[cfg(feature = "mem-census")]
+        if r.is_ok() {
+            crate::memcensus::s151_borrow(true);
+        }
+        r
+    }
+}
+
+impl Clone for ObjRc {
+    /// C1/C5: clone dell'handle (refcount++), attribuito al sito corrente.
+    #[inline]
+    fn clone(&self) -> ObjRc {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_handle_clone(&self.0);
+        ObjRc(Rc::clone(&self.0))
+    }
+}
+
+impl Drop for ObjRc {
+    /// C1/C5: drop dell'handle (refcount--), attribuito al sito corrente.
+    #[inline]
+    fn drop(&mut self) {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_handle_drop(&self.0);
+    }
+}
+
+impl std::ops::Deref for ObjRc {
+    type Target = Rc<std::cell::RefCell<Object>>;
+    #[inline]
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl From<Rc<std::cell::RefCell<Object>>> for ObjRc {
+    /// Mint: un `Rc` nudo (weak-upgrade, `Rc::clone` diretto pre-esistente)
+    /// entra nel ledger — categoria `cloni`, sito corrente, kind `mint`.
+    #[inline]
+    fn from(rc: Rc<std::cell::RefCell<Object>>) -> ObjRc {
+        #[cfg(feature = "mem-census")]
+        crate::memcensus::s151_handle_mint(&rc);
+        ObjRc(rc)
+    }
+}
+
+impl std::fmt::Debug for ObjRc {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.0.fmt(f)
+    }
+}
