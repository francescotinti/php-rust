+const S151_KIND_NAMES: [&str; S151_K] = ["scalar", "str", "arr", "obj", "ref", "rcother"];
+#[cfg(feature = "mem-census")]
+const S151_CLS: usize = 4096;
+#[cfg(feature = "mem-census")]
+const S151_CLS_NAME_MAX: usize = 64;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_ALLOC_INSTANCE: u8 = 0;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_ALLOC_SEEDED: u8 = 1;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_PROXY_WRAPPER: u8 = 2;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_CLONE_COPY: u8 = 3;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_ENUM_CASE: u8 = 4;
+#[cfg(feature = "mem-census")]
+pub const S151_CTOR_OTHER: u8 = 7;
+#[cfg(feature = "mem-census")]
+const S151_CTORS: usize = 8;
+#[cfg(feature = "mem-census")]
+const S151_CTOR_NAMES: [&str; S151_CTORS] = [
+    "alloc_instance", "alloc_seeded", "proxy_wrapper", "clone_copy", "enum_case", "ctor5",
+    "ctor6", "ctor_other",
+];
+
+#[cfg(feature = "mem-census")]
+static S151_C1_CLONE: [AtomicU64; S151_N_SITES] = [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C1_MINT: [AtomicU64; S151_N_SITES] = [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C1_DROP: [AtomicU64; S151_N_SITES] = [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C2_BORROW: [AtomicU64; S151_N_SITES] = [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C2_BORROWMUT: [AtomicU64; S151_N_SITES] =
+    [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C3_N: [AtomicU64; S151_CTORS] = [const { AtomicU64::new(0) }; S151_CTORS];
+#[cfg(feature = "mem-census")]
+static S151_C4: [AtomicU64; S151_N_SITES] = [const { AtomicU64::new(0) }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C5_CLONE: [[AtomicU64; S151_K]; S151_N_SITES] =
+    [const { [const { AtomicU64::new(0) }; S151_K] }; S151_N_SITES];
+#[cfg(feature = "mem-census")]
+static S151_C5_DROP: [[AtomicU64; S151_K]; S151_N_SITES] =
+    [const { [const { AtomicU64::new(0) }; S151_K] }; S151_N_SITES];
+/// Totali per canale (c1..c5), incrementati DALLO STESSO hook del sito.
+#[cfg(feature = "mem-census")]
+static S151_TOT: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+/// GRAND: ogni evento clone/mint (risp. drop) dell'handle, PRIMA
+/// dell'instradamento — la base dell'overlap.
+#[cfg(feature = "mem-census")]
+static S151_GRAND_CLONE: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "mem-census")]
+static S151_GRAND_DROP: AtomicU64 = AtomicU64::new(0);
+
+#[cfg(feature = "mem-census")]
+static S151_CLS_KEY: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_NAME_LEN: [AtomicU8; S151_CLS] = [const { AtomicU8::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_NAME_BYTES: [[AtomicU8; S151_CLS_NAME_MAX]; S151_CLS] =
+    [const { [const { AtomicU8::new(0) }; S151_CLS_NAME_MAX] }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_B: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_C: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_D: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_DEATH: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_CLS_OVF: AtomicU64 = AtomicU64::new(0);
+
+#[cfg(feature = "mem-census")]
+static S151_SNAP_TAKEN: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "mem-census")]
+static S151_SNAP_B: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_SNAP_C: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_SNAP_D: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_SNAP_LH: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+#[cfg(feature = "mem-census")]
+static S151_SNAP_LO: [AtomicU64; S151_CLS] = [const { AtomicU64::new(0) }; S151_CLS];
+
+/// N2 (Leijen): distribuzione #props per ISTANZA, campionata una volta per
+/// istanza (alla morte se muore prima dello snapshot di fine-request, nello
+/// snapshot se e' viva li'). Bucket esatti 0..=63, [64] = ">=64".
+#[cfg(feature = "mem-census")]
+static S151_PROPS_HIST: [AtomicU64; 65] = [const { AtomicU64::new(0) }; 65];
+#[cfg(feature = "mem-census")]
+static S151_DYN_HIST: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+#[cfg(feature = "mem-census")]
+static S151_PROPS_N: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "mem-census")]
+static S151_PROPS_SUM: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "mem-census")]
+static S151_DYN_OBJS: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "mem-census")]
+static S151_DYN_ENTRIES_SUM: AtomicU64 = AtomicU64::new(0);
+
+#[cfg(feature = "mem-census")]
+std::thread_local! {
+    /// Scope RAII del funnel di costruzione corrente (C3); 0xFF = nessuno.
+    static S151_CTOR: std::cell::Cell<u8> = const { std::cell::Cell::new(u8::MAX) };
+    /// Override di FASE del sito (fuori dal dispatch); u16::MAX = nessuno.
+    static S151_OVR: std::cell::Cell<u16> = const { std::cell::Cell::new(u16::MAX) };
+}
+
+/// Sito simbolico corrente: override di fase se attivo, altrimenti l'op
+/// corrente del dispatch (tabella s147; 255 = outside).
+#[cfg(feature = "mem-census")]
+#[inline]
+fn s151_site() -> usize {
+    let o = S151_OVR.try_with(|c| c.get()).unwrap_or(u16::MAX);
+    if o != u16::MAX {
+        return (o as usize).min(S151_N_SITES - 1);
+    }
+    let cur = S147_SITE.try_with(|c| c.get().1).unwrap_or(S147_OUTSIDE);
+    (cur as usize).min(S151_N_SITES - 1)
+}
+
+#[cfg(feature = "mem-census")]
+fn s151_site_name(i: usize) -> &'static str {
+    match i as u16 {
+        S151_SITE_REQ_END => "req_end",
+        S151_SITE_GC_COLLECT => "gc_collect",
+        S151_SITE_FRAME_TEARDOWN => "frame_teardown",
+        S151_SITE_SHUTDOWN_FN => "shutdown_fn",
+        S151_SITE_SHUTDOWN_DTOR => "shutdown_dtor",
+        _ => s147_site_name(i),
+    }
+}
+
+/// Famiglia-prop (perimetro C5, lista CHIUSA dichiarata al criterio §2):
+/// gli op di accesso a proprieta' d'istanza/statiche del dispatch.
+#[cfg(feature = "mem-census")]
+static S151_PROPFAM: std::sync::OnceLock<[bool; S151_N_SITES]> = std::sync::OnceLock::new();
+
+#[cfg(feature = "mem-census")]
+#[inline]
+fn s151_is_propfam(s: usize) -> bool {
+    // Prima della registrazione dei nomi (entro il primo run_loop) nessun op
+    // e' in esecuzione: la famiglia e' vuota per definizione.
+    if S147_NAMES.get().is_none() {
+        return false;
+    }
+    S151_PROPFAM.get_or_init(|| {
+        let mut t = [false; S151_N_SITES];
+        if let Some(names) = S147_NAMES.get() {
+            for (i, n) in names.iter().enumerate().take(S151_N_SITES) {
+                t[i] = matches!(
+                    *n,
+                    "PropGet"
+                        | "PropSet"
+                        | "PropOpSet"
+                        | "PropIncDec"
+                        | "PropIsset"
+                        | "PropIssetFetchGate"
+                        | "PropIssetDyn"
+                        | "PropGetSilent"
+                        | "PropGetDynamic"
+                        | "PropGetDynamicSilent"
+                        | "PropUnset"
+                        | "ThisPropGet"
+                        | "PropGetSlot"
+                        | "PropSetPop"
+                        | "PropGetSlotRecv"
+                        | "BinaryTCPropSetPop"
+                        | "PropDimGetConst"
+                        | "FieldAssign"
+                        | "FieldAssignOp"
+                        | "FieldIncDec"
+                        | "FieldIsset"
+                        | "FieldEmpty"
+                        | "FieldUnset"
+                        | "StaticPropGet"
+                        | "StaticPropSet"
+                        | "StaticPropRef"
+                        | "StaticPropOpSet"
+                        | "StaticPropIncDec"
+                        | "StaticPropGetDynamic"
+                        | "StaticPropSetDynamic"
+                        | "StaticPropOpSetDynamic"
+                        | "StaticPropIncDecDynamic"
+                        | "StaticPropGetDynName"
+                        | "StaticPropSetDynName"
+                );
+            }
+        }
+        t
+    })[s]
+}
+
+/// Interning del nome-classe (stessa meccanica FNV-1a/64 + open addressing di
+/// `s149_slot_for`; tabella statica pre-allocata, il censimento non alloca).
+#[cfg(feature = "mem-census")]
+#[inline]
+fn s151_cls_for(name: &[u8]) -> u32 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for &b in name {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    if h == 0 {
+        h = 1;
+    }
+    let mut i = (h as usize) & (S151_CLS - 1);
+    for _ in 0..S151_CLS {
+        let k = S151_CLS_KEY[i].load(Relaxed);
+        if k == h {
+            return i as u32;
+        }
+        if k == 0 {
+            match S151_CLS_KEY[i].compare_exchange(0, h, Relaxed, Relaxed) {
+                Ok(_) => {
+                    let l = name.len().min(S151_CLS_NAME_MAX);
+                    for (j, &b) in name[..l].iter().enumerate() {
+                        S151_CLS_NAME_BYTES[i][j].store(b, Relaxed);
+                    }
+                    S151_CLS_NAME_LEN[i].store(l as u8, Relaxed);
+                    return i as u32;
+                }
+                Err(k2) if k2 == h => return i as u32,
+                Err(_) => {}
+            }
+        }
+        i = (i + 1) & (S151_CLS - 1);
+    }
+    S151_CLS_OVF.fetch_add(1, Relaxed);
+    u32::MAX
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+fn s151_cls_of(rc: &std::rc::Rc<std::cell::RefCell<crate::Object>>) -> u32 {
+    match rc.try_borrow() {
+        Ok(b) => s151_cls_for(b.class_name.as_bytes()),
+        Err(_) => s151_cls_for(b"<unborrowable>"),
+    }
+}
+
+/// Nascita di un oggetto (handle #1) — chiamata SOLO da `ObjRc::birth`.
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_birth(rc: &std::rc::Rc<std::cell::RefCell<crate::Object>>) {
+    let cls = s151_cls_of(rc);
+    if cls != u32::MAX {
+        S151_CLS_B[cls as usize].fetch_add(1, Relaxed);
+    }
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_handle_clone(rc: &std::rc::Rc<std::cell::RefCell<crate::Object>>) {
+    S151_GRAND_CLONE.fetch_add(1, Relaxed);
+    let cls = s151_cls_of(rc);
+    if cls != u32::MAX {
+        S151_CLS_C[cls as usize].fetch_add(1, Relaxed);
+    }
+    let s = s151_site();
+    if s151_is_propfam(s) {
+        S151_C5_CLONE[s][3].fetch_add(1, Relaxed);
+        S151_TOT[4].fetch_add(1, Relaxed);
+    } else {
+        S151_C1_CLONE[s].fetch_add(1, Relaxed);
+        S151_TOT[0].fetch_add(1, Relaxed);
+    }
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_handle_mint(rc: &std::rc::Rc<std::cell::RefCell<crate::Object>>) {
+    S151_GRAND_CLONE.fetch_add(1, Relaxed);
+    let cls = s151_cls_of(rc);
+    if cls != u32::MAX {
+        S151_CLS_C[cls as usize].fetch_add(1, Relaxed);
+    }
+    let s = s151_site();
+    S151_C1_MINT[s].fetch_add(1, Relaxed);
+    S151_TOT[0].fetch_add(1, Relaxed);
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_handle_drop(rc: &std::rc::Rc<std::cell::RefCell<crate::Object>>) {
+    S151_GRAND_DROP.fetch_add(1, Relaxed);
+    let cls = s151_cls_of(rc);
+    if cls != u32::MAX {
+        S151_CLS_D[cls as usize].fetch_add(1, Relaxed);
+    }
+    let s = s151_site();
+    if s151_is_propfam(s) {
+        S151_C5_DROP[s][3].fetch_add(1, Relaxed);
+        S151_TOT[4].fetch_add(1, Relaxed);
+    } else {
+        S151_C1_DROP[s].fetch_add(1, Relaxed);
+        S151_TOT[0].fetch_add(1, Relaxed);
+    }
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_borrow(mutable: bool) {
+    let s = s151_site();
+    if mutable {
+        S151_C2_BORROWMUT[s].fetch_add(1, Relaxed);
+    } else {
+        S151_C2_BORROW[s].fetch_add(1, Relaxed);
+    }
+    S151_TOT[1].fetch_add(1, Relaxed);
+}
+
+/// C4: `Vm::gc_note` chiamata con argomento Object (nota dal VM).
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_c4_note() {
+    let s = s151_site();
+    S151_C4[s].fetch_add(1, Relaxed);
+    S151_TOT[3].fetch_add(1, Relaxed);
+}
+
+/// C5: clone di un VALORE Zval non-Object (k = indice s145) — conta solo se
+/// il sito corrente e' nella famiglia-prop.
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_c5_value_clone(k: usize) {
+    let s = s151_site();
+    if s151_is_propfam(s) {
+        S151_C5_CLONE[s][k.min(S151_K - 1)].fetch_add(1, Relaxed);
+        S151_TOT[4].fetch_add(1, Relaxed);
+    }
+}
+
+/// C5: valore DISPLACED (il vecchio valore scalzato da un write_property*).
+/// L'Object non si conta qui: il suo drop passa dal hook dell'handle.
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_c5_displaced(v: &crate::Zval) {
+    use crate::Zval;
+    let k = match v {
+        Zval::Undef | Zval::Null | Zval::Bool(_) | Zval::Long(_) | Zval::Double(_) => 0,
+        Zval::Str(_) => 1,
+        Zval::Array(_) => 2,
+        Zval::Object(_) => return,
+        Zval::Ref(_) => 4,
+        _ => 5,
+    };
+    let s = s151_site();
+    S151_C5_DROP[s][k].fetch_add(1, Relaxed);
+    S151_TOT[4].fetch_add(1, Relaxed);
+}
+
+/// RAII del funnel di costruzione (C3).
+#[cfg(feature = "mem-census")]
+pub struct S151CtorScope {
+    prev: u8,
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_ctor_scope(site: u8) -> S151CtorScope {
+    let prev = S151_CTOR
+        .try_with(|c| {
+            let p = c.get();
+            c.set(site);
+            p
+        })
+        .unwrap_or(u8::MAX);
+    S151CtorScope { prev }
+}
+
+#[cfg(feature = "mem-census")]
+impl Drop for S151CtorScope {
+    #[inline]
+    fn drop(&mut self) {
+        let _ = S151_CTOR.try_with(|c| c.set(self.prev));
+    }
+}
+
+/// Hook dal wrapper GlobalAlloc (via `galloc_note`): C3.
+#[cfg(feature = "mem-census")]
+#[inline]
+fn s151_ctor_alloc_note() {
+    let c = S151_CTOR.try_with(|c| c.get()).unwrap_or(u8::MAX);
+    if c != u8::MAX {
+        S151_C3_N[(c as usize).min(S151_CTORS - 1)].fetch_add(1, Relaxed);
+        S151_TOT[2].fetch_add(1, Relaxed);
+    }
+}
+
+/// RAII dell'override di FASE del sito (shutdown/teardown/gc/req_end).
+#[cfg(feature = "mem-census")]
+pub struct S151Ovr {
+    prev: u16,
+}
+
+#[cfg(feature = "mem-census")]
+#[inline]
+pub fn s151_override(site: u16) -> S151Ovr {
+    let prev = S151_OVR
+        .try_with(|c| {
+            let p = c.get();
+            c.set(site);
+            p
+        })
+        .unwrap_or(u16::MAX);
+    S151Ovr { prev }
+}
+
+#[cfg(feature = "mem-census")]
+impl Drop for S151Ovr {
+    #[inline]
+    fn drop(&mut self) {
+        let _ = S151_OVR.try_with(|c| c.set(self.prev));
+    }
+}
+
+/// Snapshot di FINE REQUEST (N6): congela il ledger per-classe b/c/d allo
+/// stesso istante in cui il walker misura i vivi (prima volta sola).
+#[cfg(feature = "mem-census")]
+pub fn s151_snap_begin() {
+    if S151_SNAP_TAKEN.swap(1, Relaxed) != 0 {
+        return;
+    }
+    for i in 0..S151_CLS {
+        S151_SNAP_B[i].store(S151_CLS_B[i].load(Relaxed), Relaxed);
+        S151_SNAP_C[i].store(S151_CLS_C[i].load(Relaxed), Relaxed);
+        S151_SNAP_D[i].store(S151_CLS_D[i].load(Relaxed), Relaxed);
+    }
+}
+
+/// Un oggetto VIVO al momento dello snapshot: classe + handle forti misurati
+/// (INDIPENDENTI dal ledger: e' il walker dello store a contarli) + campione
+/// props (N2).
+#[cfg(feature = "mem-census")]
+pub fn s151_snap_object(o: &crate::Object, strongs: usize) {
+    let cls = s151_cls_for(o.class_name.as_bytes());
+    if cls != u32::MAX {
+        S151_SNAP_LH[cls as usize].fetch_add(strongs as u64, Relaxed);
+        S151_SNAP_LO[cls as usize].fetch_add(1, Relaxed);
+    }
+    let (np, nd) = o.s151_props_counts();
+    s151_props_sample(np, nd);
+}
+
+/// Morte dell'OGGETTO (da `Object::drop`, id != 0): per classe; campiona la
+/// distribuzione props solo PRIMA dello snapshot (una istanza = un campione).
+#[cfg(feature = "mem-census")]
+pub fn s151_death(name: &[u8], np: usize, nd: usize) {
+    let cls = s151_cls_for(name);
+    if cls != u32::MAX {
+        S151_CLS_DEATH[cls as usize].fetch_add(1, Relaxed);
+    }
+    if S151_SNAP_TAKEN.load(Relaxed) == 0 {
+        s151_props_sample(np, nd);
+    }
+}
+
+#[cfg(feature = "mem-census")]
+fn s151_props_sample(np: usize, nd: usize) {
+    S151_PROPS_HIST[np.min(64)].fetch_add(1, Relaxed);
+    S151_DYN_HIST[nd.min(16)].fetch_add(1, Relaxed);
+    S151_PROPS_N.fetch_add(1, Relaxed);
+    S151_PROPS_SUM.fetch_add(np as u64, Relaxed);
+    if nd > 0 {
+        S151_DYN_OBJS.fetch_add(1, Relaxed);
+        S151_DYN_ENTRIES_SUM.fetch_add(nd as u64, Relaxed);
+    }
+}
+
+#[cfg(feature = "mem-census")]
+fn s151_cls_name(i: usize) -> String {
+    let l = S151_CLS_NAME_LEN[i].load(Relaxed) as usize;
+    let raw: Vec<u8> = (0..l).map(|j| S151_CLS_NAME_BYTES[i][j].load(Relaxed)).collect();
+    String::from_utf8_lossy(&raw).replace([' ', '\t'], "_")
+}
+
+/// Righe s151* appese a `PHPR_MEM_CENSUS` a fine processo. Snapshot COERENTE
+/// dei contatori PRIMA di ogni alloc del dump (pattern s148/s149).
+#[cfg(feature = "mem-census")]
+fn s151_dump_lines() {
+    use std::io::Write;
+    let Ok(path) = std::env::var("PHPR_MEM_CENSUS") else { return };
+    // Snapshot atomico di tutto cio' che entra nelle identita', PRIMA di
+    // aprire file / allocare.
+    let tot: [u64; 5] = std::array::from_fn(|i| S151_TOT[i].load(Relaxed));
+    let grand_clone = S151_GRAND_CLONE.load(Relaxed);
+    let grand_drop = S151_GRAND_DROP.load(Relaxed);
+    let c1c: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C1_CLONE[i].load(Relaxed)).collect();
+    let c1m: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C1_MINT[i].load(Relaxed)).collect();
+    let c1d: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C1_DROP[i].load(Relaxed)).collect();
+    let c2b: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C2_BORROW[i].load(Relaxed)).collect();
+    let c2m: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C2_BORROWMUT[i].load(Relaxed)).collect();
+    let c3: Vec<u64> = (0..S151_CTORS).map(|i| S151_C3_N[i].load(Relaxed)).collect();
+    let c4: Vec<u64> = (0..S151_N_SITES).map(|i| S151_C4[i].load(Relaxed)).collect();
+    let c5c: Vec<[u64; S151_K]> = (0..S151_N_SITES)
+        .map(|i| std::array::from_fn(|k| S151_C5_CLONE[i][k].load(Relaxed)))
+        .collect();
+    let c5d: Vec<[u64; S151_K]> = (0..S151_N_SITES)
+        .map(|i| std::array::from_fn(|k| S151_C5_DROP[i][k].load(Relaxed)))
+        .collect();
+    let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) else {
+        return;
+    };
+    for i in 0..S151_N_SITES {
+        let n = s151_site_name(i);
+        if c1c[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c1 site={n}.clone n={}", c1c[i]);
+        }
+        if c1m[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c1 site={n}.mint n={}", c1m[i]);
+        }
+        if c1d[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c1 site={n}.drop n={}", c1d[i]);
+        }
+        if c2b[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c2 site={n}.borrow n={}", c2b[i]);
+        }
+        if c2m[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c2 site={n}.borrow_mut n={}", c2m[i]);
+        }
+        if c4[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c4 site={n} n={}", c4[i]);
+        }
+        for k in 0..S151_K {
+            if c5c[i][k] > 0 {
+                let _ = writeln!(
+                    f,
+                    "s151site channel=c5 site={n}.{}.clone n={}",
+                    S151_KIND_NAMES[k], c5c[i][k]
+                );
+            }
+            if c5d[i][k] > 0 {
+                let _ = writeln!(
+                    f,
+                    "s151site channel=c5 site={n}.{}.drop n={}",
+                    S151_KIND_NAMES[k], c5d[i][k]
+                );
+            }
+        }
+    }
+    for i in 0..S151_CTORS {
+        if c3[i] > 0 {
+            let _ = writeln!(f, "s151site channel=c3 site={} n={}", S151_CTOR_NAMES[i], c3[i]);
+        }
+    }
+    for (ch, t) in ["c1", "c2", "c3", "c4", "c5"].iter().zip(tot.iter()) {
+        let _ = writeln!(f, "s151tot channel={ch} n={t}");
+    }
+    // Overlap: somma canali instradati vs GRAND (per eventi handle).
+    let routed_clone: u64 = (0..S151_N_SITES)
+        .map(|i| c1c[i] + c1m[i] + c5c[i][3])
+        .sum();
+    let routed_drop: u64 = (0..S151_N_SITES).map(|i| c1d[i] + c5d[i][3]).sum();
+    let overlap = routed_clone.abs_diff(grand_clone) + routed_drop.abs_diff(grand_drop);
+    let _ = writeln!(f, "s151overlap n={overlap}");
+    let _ = writeln!(f, "s151grand clone={grand_clone} drop={grand_drop}");
+    // Conservazione per classe (snapshot di fine request) + N6.
+    let snap = S151_SNAP_TAKEN.load(Relaxed);
+    let _ = writeln!(f, "s151snap taken={snap}");
+    for i in 0..S151_CLS {
+        if S151_CLS_KEY[i].load(Relaxed) == 0 {
+            continue;
+        }
+        let (b, c, d) = (
+            S151_SNAP_B[i].load(Relaxed),
+            S151_SNAP_C[i].load(Relaxed),
+            S151_SNAP_D[i].load(Relaxed),
+        );
+        let (lh, lo) = (S151_SNAP_LH[i].load(Relaxed), S151_SNAP_LO[i].load(Relaxed));
+        if snap != 0 && (b + c + d + lh + lo) > 0 {
+            let _ = writeln!(
+                f,
+                "s151cons class={} births={b} clones={c} drops={d} live_end={lh}",
+                s151_cls_name(i)
+            );
+            let _ = writeln!(
+                f,
+                "s151n6 class={} objects={lo} deaths={}",
+                s151_cls_name(i),
+                S151_CLS_DEATH[i].load(Relaxed)
+            );
+        }
+    }
+    let _ = writeln!(f, "s151clsovf n={}", S151_CLS_OVF.load(Relaxed));
+    // N2: distribuzione #props (percentili PESATI dal histogramma).
+    let hist: [u64; 65] = std::array::from_fn(|i| S151_PROPS_HIST[i].load(Relaxed));
+    let dhist: [u64; 17] = std::array::from_fn(|i| S151_DYN_HIST[i].load(Relaxed));
+    let nsamples = S151_PROPS_N.load(Relaxed);
+    let psum = S151_PROPS_SUM.load(Relaxed);
+    let pct = |q: f64| -> usize {
+        if nsamples == 0 {
+            return 0;
+        }
+        let target = (q * nsamples as f64).ceil() as u64;
+        let mut acc = 0u64;
+        for (i, h) in hist.iter().enumerate() {
+            acc += h;
+            if acc >= target {
+                return i;
+            }
+        }
+        64
+    };
+    let le = |k: usize| -> f64 {
+        if nsamples == 0 {
+            return 0.0;
+        }
+        let s: u64 = hist[..=k].iter().sum();
+        s as f64 * 100.0 / nsamples as f64
+    };
+    let _ = writeln!(
+        f,
+        "s151props n={} sum={} p50={} p90={} p99={} le4_pct={:.2} le8_pct={:.2} dyn_objs={} dyn_entries={}",
+        nsamples,
+        psum,
+        pct(0.50),
+        pct(0.90),
+        pct(0.99),
+        le(4),
+        le(8),
+        S151_DYN_OBJS.load(Relaxed),
+        S151_DYN_ENTRIES_SUM.load(Relaxed),
+    );
+    for (i, h) in hist.iter().enumerate() {
+        if *h > 0 {
+            let _ = writeln!(f, "s151propshist bucket={i} n={h}");
+        }
+    }
+    for (i, h) in dhist.iter().enumerate() {
+        if *h > 0 {
+            let _ = writeln!(f, "s151dynhist bucket={i} n={h}");
+        }
+    }
+}
