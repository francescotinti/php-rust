micro-baseline: il rapporto phpr/oracle PER CATEGORIA (la spina dorsale, S-97.0)
grade=VERDICT  # R=5 ripetizioni per lato, mediana E spread pubblicati; l'effetto misurato
  e' di ordine 10x, cioe' tre ordini di grandezza sopra la risoluzione del cronometro
formato=ascii-nudo
oracle=8.5.7 jit=disable
phpr=d9d6429301f60f4e
ripetizioni=5
metodo=user CPU di /usr/bin/time -p, AL NETTO del pavimento di avvio misurato
  sullo stesso binario con uno script vuoto (i due pavimenti sono DIVERSI)
pavimento_oracle_s=0.05
pavimento_phpr_s=0.02

arith_N_iter=50000000
arith_oracle_netto_s=0.43
arith_phpr_netto_s=0.92
rapporto_arith=2.1  [derivata: companion 0.92/0.43]
arith_spread_oracle_s=0.00  arith_spread_phpr_s=0.04
prop_N_iter=30000000
prop_oracle_netto_s=0.42
prop_phpr_netto_s=0.95
rapporto_prop=2.3  [derivata: companion 0.95/0.42]
prop_spread_oracle_s=0.01  prop_spread_phpr_s=0.01
calls_N_iter=20000000
calls_oracle_netto_s=0.45
calls_phpr_netto_s=1.58
rapporto_calls=3.5  [derivata: companion 1.58/0.45]
calls_spread_oracle_s=0.02  calls_spread_phpr_s=0.03
str_N_iter=4000000
str_oracle_netto_s=0.15
str_phpr_netto_s=0.61
rapporto_str=4.1  [derivata: companion 0.61/0.15]
str_spread_oracle_s=0.00  str_spread_phpr_s=0.01
arr_N_iter=100000
arr_oracle_netto_s=0.28
arr_phpr_netto_s=0.81
rapporto_arr=2.9  [derivata: companion 0.81/0.28]
arr_spread_oracle_s=0.01  arr_spread_phpr_s=0.01
re_N_iter=2000000
re_oracle_netto_s=0.36
re_phpr_netto_s=0.91
rapporto_re=2.5  [derivata: companion 0.91/0.36]
re_spread_oracle_s=0.00  re_spread_phpr_s=0.01
