micro-baseline: il rapporto phpr/oracle PER CATEGORIA (la spina dorsale, S-97.0)
grade=VERDICT  # R=5 ripetizioni per lato, mediana E spread pubblicati; l'effetto misurato
  e' di ordine 10x, cioe' tre ordini di grandezza sopra la risoluzione del cronometro
formato=ascii-nudo
oracle=8.5.7 jit=disable
phpr=eb555106a3c7b718
ripetizioni=5
metodo=user CPU di /usr/bin/time -p, AL NETTO del pavimento di avvio misurato
  sullo stesso binario con uno script vuoto (i due pavimenti sono DIVERSI)
pavimento_oracle_s=0.05
pavimento_phpr_s=0.02

arith_N_iter=50000000
arith_oracle_netto_s=0.43
arith_phpr_netto_s=4.97
rapporto_arith=11.6  [derivata: companion 4.97/0.43]
arith_spread_oracle_s=0.01  arith_spread_phpr_s=0.02
prop_N_iter=30000000
prop_oracle_netto_s=0.42
prop_phpr_netto_s=4.45
rapporto_prop=10.6  [derivata: companion 4.45/0.42]
prop_spread_oracle_s=0.01  prop_spread_phpr_s=0.09
calls_N_iter=20000000
calls_oracle_netto_s=0.44
calls_phpr_netto_s=2.77
rapporto_calls=6.3  [derivata: companion 2.77/0.44]
calls_spread_oracle_s=0.03  calls_spread_phpr_s=0.03
str_N_iter=4000000
str_oracle_netto_s=0.16
str_phpr_netto_s=1.06
rapporto_str=6.6  [derivata: companion 1.06/0.16]
str_spread_oracle_s=0.00  str_spread_phpr_s=0.05
arr_N_iter=100000
arr_oracle_netto_s=0.29
arr_phpr_netto_s=1.23
rapporto_arr=4.2  [derivata: companion 1.23/0.29]
arr_spread_oracle_s=0.02  arr_spread_phpr_s=0.06
re_N_iter=2000000
re_oracle_netto_s=0.37
re_phpr_netto_s=1.31
rapporto_re=3.5  [derivata: companion 1.31/0.37]
re_spread_oracle_s=0.01  re_spread_phpr_s=0.02
