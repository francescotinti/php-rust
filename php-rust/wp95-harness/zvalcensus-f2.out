sites_safe=51697
nota-determinismo=slot_reads/would_take* della parte F1 riprodotti IDENTICI al run F1
safe_su_would_take_pct=90.21  [derivata: companion 25826615/28628306]  # P2 chiede >=60
safe_rc_su_slot_reads_rc_pct=42.33  [derivata: companion 22674665/53561199]
