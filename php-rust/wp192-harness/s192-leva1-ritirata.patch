index e65fe764..2db5c212 100644
--- a/php-rust/crates/php-runtime/src/vm/gc_probe.rs
+++ b/php-rust/crates/php-runtime/src/vm/gc_probe.rs
@@ -67,6 +67,31 @@ impl<'m> Vm<'m> {
         Ok(())
     }
 
+    /// S-192 (criterion `wp192-harness/s192-criterio-k0.md`): the probe's
+    /// answer computed IN LINE for the one window a method `Ret` produces at
+    /// every return — a single tail slot (the live `$this` re-noted by
+    /// `gc_note_slow` (iv-b)) that is not collectable. Returns `true` when the
+    /// call can be skipped, after leaving exactly the state `gc_ret_probe`
+    /// would leave: cursor advanced unless one of its three guards holds.
+    /// Every other window (wider, or a tail with count 2) answers `false`.
+    #[inline(always)]
+    pub(super) fn gc_probe_idle(&mut self, caller: usize) -> bool {
+        let len = self.gc_buf.len();
+        if self.gc_probe_mark + 1 != len {
+            return false;
+        }
+        if self.gc_buf.last().is_some_and(|s| s.as_ref().is_some_and(|o| Rc::strong_count(o) == 2)) {
+            return false;
+        }
+        if self.gc_buf_head == 0
+            && !self.gc_collecting
+            && !self.frames.get(caller).is_some_and(|f| f.flags.get(FrameFlags::IN_DESTRUCTOR))
+        {
+            self.gc_probe_mark = len;
+        }
+        true
+    }
+
     /// Drop every buffered candidate and rewind both cursors (request reset,
     /// shutdown). The sweep tail and `collect_cycles` drain in place and reset
     /// `gc_probe_mark` themselves.
diff --git a/php-rust/crates/php-runtime/src/vm/run.rs b/php-rust/crates/php-runtime/src/vm/run.rs
index 4b03d95c..f421e7a6 100644
--- a/php-rust/crates/php-runtime/src/vm/run.rs
+++ b/php-rust/crates/php-runtime/src/vm/run.rs
@@ -4330,7 +4330,7 @@ impl<'m> super::Vm<'m> {
                         self.frames.truncate(top);
                         self.frame_pool.put(slots, stack);
                         // §3.35: dying locals destruct at `leave` — S-190 cursor probe (vm/gc_probe), out of line.
-                        if self.gc_probe_mark < self.gc_buf.len() {
+                        if self.gc_probe_mark < self.gc_buf.len() && !self.gc_probe_idle(top - 1) {
                             self.gc_ret_probe(top - 1)?;
                         }
                         if self.frames.len() == baseline {
@@ -7310,7 +7310,7 @@ impl<'m> super::Vm<'m> {
         }
         // §3.35: dying locals destruct at `leave` (S-190 cursor probe, vm/gc_probe); a destructor
         // frame's own return keeps the scheduled-sweep protocol (its Sweep op re-runs when it returns).
-        if top > 0 && fl & FrameFlags::IN_DESTRUCTOR == 0 && self.gc_probe_mark < self.gc_buf.len() {
+        if top > 0 && fl & FrameFlags::IN_DESTRUCTOR == 0 && self.gc_probe_mark < self.gc_buf.len() && !self.gc_probe_idle(top - 1) {
             self.gc_ret_probe(top - 1)?;
         }
         if let Some(guard) = guard {
