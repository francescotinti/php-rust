+    /// exactly as there (LSB = receiver's actual class).
+    fn push_method_frame_one(
+        &mut self,
+        defc: usize,
+        midx: usize,
+        cid: usize,
+        this: Zval,
+        arg: Zval,
+    ) -> Result<(), PhpError> {
+        let callee = &self.classes[defc].methods[midx].func;
+        debug_assert!(callee.simple_call && callee.n_params == 1);
