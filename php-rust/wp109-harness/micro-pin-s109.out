micro-baseline: il rapporto phpr/oracle PER CATEGORIA (la spina dorsale, S-97.0)
grade=VERDICT  # R=5 ripetizioni per lato, mediana E spread pubblicati; l'effetto misurato
  e' di ordine 10x, cioe' tre ordini di grandezza sopra la risoluzione del cronometro
formato=ascii-nudo
oracle=8.5.7 jit=disable
phpr=929095448e823cb5
ripetizioni=5
metodo=user CPU di /usr/bin/time -p, AL NETTO del pavimento di avvio misurato
  sullo stesso binario con uno script vuoto (i due pavimenti sono DIVERSI)
pavimento_oracle_s=0.05
pavimento_phpr_s=0.02

arith_N_iter=50000000
arith_oracle_netto_s=0.43
arith_phpr_netto_s=3.99
rapporto_arith=9.3  [derivata: companion 3.99/0.43]
arith_spread_oracle_s=0.00  arith_spread_phpr_s=0.06
prop_N_iter=30000000
prop_oracle_netto_s=0.42
prop_phpr_netto_s=3.33
rapporto_prop=7.9  [derivata: companion 3.33/0.42]
prop_spread_oracle_s=0.00  prop_spread_phpr_s=0.12
calls_N_iter=20000000
calls_oracle_netto_s=0.45
calls_phpr_netto_s=2.31
rapporto_calls=5.1  [derivata: companion 2.31/0.45]
calls_spread_oracle_s=0.01  calls_spread_phpr_s=0.01
str_N_iter=4000000
str_oracle_netto_s=0.16
str_phpr_netto_s=0.84
rapporto_str=5.3  [derivata: companion 0.84/0.16]
str_spread_oracle_s=0.00  str_spread_phpr_s=0.02
arr_N_iter=100000
arr_oracle_netto_s=0.29
arr_phpr_netto_s=1.13
rapporto_arr=3.9  [derivata: companion 1.13/0.29]
arr_spread_oracle_s=0.02  arr_spread_phpr_s=0.06
re_N_iter=2000000
re_oracle_netto_s=0.36
re_phpr_netto_s=1.26
rapporto_re=3.5  [derivata: companion 1.26/0.36]
re_spread_oracle_s=0.01  re_spread_phpr_s=0.02
