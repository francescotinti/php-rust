+// MOCK m2 (S-168, criterio s168-criterio-mock.md): l'arm Long di
+// `binary_fast` COTTO per operatore (corpo VERBATIM, l'op non è più un dato a
+// runtime); ogni altra coppia di tag cade al funnel generico. Braccio di
+// MISURA, non leva promossa.
+#[inline(always)]
+fn mock_long_mul(lhs: &Zval, rhs: &Zval) -> Option<Zval> {
+    match (lhs, rhs) {
+        (Zval::Long(l), Zval::Long(r)) => Some(match l.checked_mul(*r) {
+            Some(s) => Zval::Long(s),
+            None => Zval::Double(*l as f64 * *r as f64),
+        }),
+        _ => None,
+    }
+}
+#[inline(always)]
+fn mock_long_sub(lhs: &Zval, rhs: &Zval) -> Option<Zval> {
+    match (lhs, rhs) {
+        (Zval::Long(l), Zval::Long(r)) => Some(match l.checked_sub(*r) {
+            Some(s) => Zval::Long(s),
+            None => Zval::Double(*l as f64 - *r as f64),
+        }),
+        _ => None,
+    }
+}
+#[inline(always)]
+fn mock_long_add(lhs: &Zval, rhs: &Zval) -> Option<Zval> {
+    match (lhs, rhs) {
+        (Zval::Long(l), Zval::Long(r)) => Some(match l.checked_add(*r) {
+            Some(s) => Zval::Long(s),
+            None => Zval::Double(*l as f64 + *r as f64),
+        }),
+        _ => None,
+    }
+}
+#[inline(always)]
+fn mock_long_shr(lhs: &Zval, rhs: &Zval) -> Option<Zval> {
+    match (lhs, rhs) {
+        (Zval::Long(l), Zval::Long(r)) => {
+            let (l, r) = (*l, *r);
+            if r < 0 {
+                return None;
+            }
+            Some(if r >= 64 { Zval::Long(if l < 0 { -1 } else { 0 }) } else { Zval::Long(l >> r) })
+        }
+        _ => None,
+    }
+}
