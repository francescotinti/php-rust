micro-baseline: il rapporto phpr/oracle PER CATEGORIA (la spina dorsale, S-97.0)
grade=VERDICT  # R=5 ripetizioni per lato, mediana E spread pubblicati; l'effetto misurato
  e' di ordine 10x, cioe' tre ordini di grandezza sopra la risoluzione del cronometro
formato=ascii-nudo
oracle=8.5.7 jit=disable
phpr=834f5e01fbdb7ebc
ripetizioni=5
metodo=user CPU di /usr/bin/time -p, AL NETTO del pavimento di avvio misurato
  sullo stesso binario con uno script vuoto (i due pavimenti sono DIVERSI)
pavimento_oracle_s=0.05
pavimento_phpr_s=0.02

arith_N_iter=50000000
arith_oracle_netto_s=0.43
arith_phpr_netto_s=2.34
rapporto_arith=5.4  [derivata: companion 2.34/0.43]
arith_spread_oracle_s=0.01  arith_spread_phpr_s=0.04
prop_N_iter=30000000
prop_oracle_netto_s=0.42
prop_phpr_netto_s=2.29
rapporto_prop=5.5  [derivata: companion 2.29/0.42]
prop_spread_oracle_s=0.00  prop_spread_phpr_s=0.03
calls_N_iter=20000000
calls_oracle_netto_s=0.45
calls_phpr_netto_s=2.11
rapporto_calls=4.7  [derivata: companion 2.11/0.45]
calls_spread_oracle_s=0.02  calls_spread_phpr_s=0.04
str_N_iter=4000000
str_oracle_netto_s=0.15
str_phpr_netto_s=0.63
rapporto_str=4.2  [derivata: companion 0.63/0.15]
str_spread_oracle_s=0.00  str_spread_phpr_s=0.01
arr_N_iter=100000
arr_oracle_netto_s=0.29
arr_phpr_netto_s=0.96
rapporto_arr=3.3  [derivata: companion 0.96/0.29]
arr_spread_oracle_s=0.01  arr_spread_phpr_s=0.05
re_N_iter=2000000
re_oracle_netto_s=0.37
re_phpr_netto_s=0.92
rapporto_re=2.5  [derivata: companion 0.92/0.37]
re_spread_oracle_s=0.02  re_spread_phpr_s=0.01
