micro-baseline: il rapporto phpr/oracle PER CATEGORIA (la spina dorsale, S-97.0)
grade=VERDICT  # R=5 ripetizioni per lato, mediana E spread pubblicati; l'effetto misurato
  e' di ordine 10x, cioe' tre ordini di grandezza sopra la risoluzione del cronometro
formato=ascii-nudo
oracle=8.5.7 jit=disable
phpr=f29883eb432806ce
ripetizioni=5
metodo=user CPU di /usr/bin/time -p, AL NETTO del pavimento di avvio misurato
  sullo stesso binario con uno script vuoto (i due pavimenti sono DIVERSI)
pavimento_oracle_s=0.05
pavimento_phpr_s=0.02

arith_oracle_netto_s=0.43
arith_phpr_netto_s=5.47
rapporto_arith=12.7  [derivata: companion 5.47/0.43]
arith_spread_oracle_s=0.01  arith_spread_phpr_s=0.08
prop_oracle_netto_s=0.42
prop_phpr_netto_s=5.22
rapporto_prop=12.4  [derivata: companion 5.22/0.42]
prop_spread_oracle_s=0.00  prop_spread_phpr_s=0.07
calls_oracle_netto_s=0.43
calls_phpr_netto_s=3.39
rapporto_calls=7.9  [derivata: companion 3.39/0.43]
calls_spread_oracle_s=0.01  calls_spread_phpr_s=0.03
str_oracle_netto_s=0.15
str_phpr_netto_s=1.07
rapporto_str=7.1  [derivata: companion 1.07/0.15]
str_spread_oracle_s=0.01  str_spread_phpr_s=0.03
arr_oracle_netto_s=0.29
arr_phpr_netto_s=1.34
rapporto_arr=4.6  [derivata: companion 1.34/0.29]
